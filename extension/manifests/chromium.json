// Chrome, Edge, Brave, Vivaldi, Arc. build.mjs takes out these comments,
// sets the version from package.json, and leaves out "key" with --store.
{
  "manifest_version": 3,
  "name": "authwing",
  "version": "0.0.0",
  "description": "Two-factor codes from the authwing app, for the exact site in front.",
  "minimum_chrome_version": "120",
  // nativeMessaging: to talk to the authwing app (through "authwing --native-host").
  // tabs: Chrome warns "Read your browsing history" for it. It is how the
  // extension knows the address of the tab in front without a click, and
  // still knows it on sites where the user has withheld site access: the
  // address is what the app checks a code's account against, to refuse a
  // look-alike site.
  "permissions": ["nativeMessaging", "tabs"],
  // To look for a code field, and fill it, on whatever site asks for a code.
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "authwing" },
  // Fixes the id of the unpacked build (jabndagnjdpnmkblgpdjonlpjllpocbl), which
  // debug builds of authwing allow. Only the public key: the private one was
  // not kept. The stores give ids of their own and take no "key".
  "key": ""
}
